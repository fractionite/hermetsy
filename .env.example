NODE_ENV=development
LISTING_EVAL_PROVIDER=rules
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
APP_ENV=local

WEB_PORT=3000
API_PORT=4000

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
PUBLIC_API_BASE_URL=
ETSY_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.app/api/auth/etsy/callback

ETSY_API_KEY=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here
ETSY_SCOPES=listings_r listings_w shops_r
ETSY_SHOP_ID=
MOCK_ETSY=true
ETSY_WRITE_DISABLED=true

POSTGRES_USER=etsy
POSTGRES_PASSWORD=etsy_password
POSTGRES_DB=etsy_listing_assistant
DATABASE_URL=postgresql://etsy:etsy_password@localhost:5432/etsy_listing_assistant?schema=public
DATABASE_URL_DOCKER=postgresql://etsy:etsy_password@postgres:5432/etsy_listing_assistant?schema=public

REDIS_URL=redis://redis:6379

SESSION_SECRET=replace_with_long_random_string
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Agent API credentials for hermetsy MCP access.
ETSYBOT_API_URL=http://localhost:4000
ETSYBOT_AGENT_READ_TOKEN=replace_with_long_random_read_token
ETSYBOT_AGENT_WRITE_TOKEN=replace_with_long_random_write_token

AI_PROVIDER=openai
AI_API_KEY=

ETSY_QPS_LIMIT=5
ETSY_QPD_LIMIT=5000
ETSY_WRITE_REQUESTS_PER_SECOND=1
ETSY_READ_REQUESTS_PER_SECOND=2
ETSY_DAILY_SAFETY_RESERVE=500
